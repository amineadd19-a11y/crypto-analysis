# Public market scanning works without API keys.
# Optional private account connectivity check; use a READ-ONLY Bybit API key.
# Never enable withdrawals. Keep trading permissions disabled for this stage.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
TRADING_ENABLED=false
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_OPEN_POSITIONS=1
# For public hosting, set REQUIRE_ACCESS_TOKEN=true and generate a long random token.
REQUIRE_ACCESS_TOKEN=false
AGENT_ACCESS_TOKEN=
