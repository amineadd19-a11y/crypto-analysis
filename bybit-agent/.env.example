# Public market scanning works without private API credentials.
# Use dedicated Bybit AI-subaccount API credentials; never enable withdrawals.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Live execution is fail-closed. Keep false until testnet validation is complete.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
LIVE_MAINNET_ACK=
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_USDT=5

# Public hosting must be protected; set a strong, unique secret.
REQUIRE_ACCESS_TOKEN=true
AGENT_ACCESS_TOKEN=
